{
  "name": "@trackdraw/viewer",
  "version": "0.1.0",
  "description": "Framework-neutral 2D/3D track viewer for TrackDraw course snapshots.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./mount": {
      "import": "./dist/mount.js"
    },
    "./snapshot/types": {
      "import": "./dist/snapshot/types.js"
    },
    "./snapshot/version": {
      "import": "./dist/snapshot/version.js"
    },
    "./snapshot/schema": {
      "import": "./dist/snapshot/schema.js"
    },
    "./assets/manifest": {
      "import": "./dist/assets/manifest.js"
    },
    "./assets/texture-paths": {
      "import": "./dist/assets/texture-paths.js"
    },
    "./assets/asset-url": {
      "import": "./dist/assets/asset-url.js"
    },
    "./static/trackdraw-viewer.css": "./dist/static/trackdraw-viewer.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dutchdronesquad/track-viewer.git"
  },
  "homepage": "https://github.com/dutchdronesquad/track-viewer",
  "bugs": "https://github.com/dutchdronesquad/track-viewer/issues",
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "clsx": "^2.1.1",
    "konva": "^10.0.2",
    "lucide-react": "^1.21.0",
    "react-konva": "19.2.7",
    "tailwind-merge": "^3.0.0",
    "three": "^0.186.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "happy-dom": "^20.8.9",
    "oxlint": "^1.75.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.0.8",
    "tailwindcss": "^4",
    "three-stdlib": "^2.36.1",
    "tsup": "^8.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.4"
  }
}
