{
  "name": "track-viewer-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/schema",
    "packages/viewer"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build --workspace @trackdraw/schema && npm run build --workspace @trackdraw/viewer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/schema/tsconfig.json && tsc --noEmit -p packages/viewer/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node --test tests/package/*.test.mjs",
    "assets:catalog-manifest": "node scripts/generate-catalog-textures.mjs",
    "dev:demo": "npm run build && node scripts/demo.mjs",
    "build:demo": "npm run build && node scripts/demo.mjs --build",
    "preview:demo": "npm run build:demo && wrangler dev --config wrangler.demo.jsonc",
    "deploy:demo": "npm run build:demo && wrangler deploy --config wrangler.demo.jsonc"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/cli": "^4",
    "@types/node": "^26.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "es-module-lexer": "^3.0.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.8.9",
    "konva": "^10.0.2",
    "lucide-react": "^1.21.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4",
    "three": "^0.186.0",
    "three-stdlib": "^2.36.1",
    "tsup": "^8.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "4.149.0"
  }
}
