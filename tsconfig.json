{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@trackdraw/viewer": ["./packages/viewer/src/index.ts"],
      "@trackdraw/viewer/*": ["./packages/viewer/src/*"],
      "@trackdraw/schema": ["./packages/schema/src/index.ts"],
      "@trackdraw/schema/*": ["./packages/schema/src/*"]
    },
    "types": ["node", "react", "react-dom"]
  },
  "include": ["packages/*/src", "tests", "lab"],
  "exclude": ["node_modules", "dist"]
}
