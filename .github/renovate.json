{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>dutchdronesquad/.github:renovate-base"],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "groupName": "Radix UI",
      "groupSlug": "radix-ui",
      "matchPackageNames": ["@radix-ui/{/,}**"]
    },
    {
      "groupName": "Vitest",
      "groupSlug": "vitest",
      "matchPackageNames": ["vitest", "@vitest/{/,}**"]
    },
    {
      "groupName": "npm dependencies",
      "groupSlug": "npm-dependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
