{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "track-viewer-demo",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "viewer.trackdraw.app", "custom_domain": true }],
  "assets": {
    "directory": "./demo/dist",
    "not_found_handling": "none",
    "html_handling": "drop-trailing-slash",
  },
}
