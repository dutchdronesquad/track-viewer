{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "track-viewer-demo",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "viewer.trackdraw.app", "custom_domain": true }],
  "assets": {
    "directory": "./demo/dist",
    "not_found_handling": "none",
  },
}
